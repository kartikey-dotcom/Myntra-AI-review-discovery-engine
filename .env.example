# ==============================================================================
# Environment Configuration: Myntra AI Review Intelligence & Governance Engine
# Copy this file to '.env' and populate with actual credentials before running.
# ==============================================================================

# Application & Server Config
PROJECT_NAME="Myntra AI Review Engine"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api/v1"

# Primary LLM Provider Configuration (Configured for Gemini AI)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_actual_gemini_api_key_here"
GEMINI_MODEL_NAME="gemini-2.5-flash"

# Database Settings
# Set DB_TYPE to 'sqlite' for local dev or 'postgresql' for production
DB_TYPE="sqlite"
DB_PATH="myntra_reviews.db"
DATABASE_URL="postgresql://myntra_user:securepassword@localhost:5432/myntra_reviews"

# Redis Cache Cluster Config
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TTL_SECONDS=3600

# Event Streaming (Apache Kafka / AWS Kinesis)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_RAW_TOPIC="kafka.reviews.raw"
KAFKA_MODERATED_TOPIC="kafka.reviews.moderated"

# OpenSearch / Elasticsearch Engine
OPENSEARCH_HOST="localhost"
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX="myntra_reviews_index"

# Validation Boundaries (as defined in edge-cases.md)
MIN_HEIGHT_CM=120.0
MAX_HEIGHT_CM=220.0
MIN_WEIGHT_KG=30.0
MAX_WEIGHT_KG=200.0

# Security & Authentication (JWT)
SECRET_KEY="replace-this-with-a-random-32-byte-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
